{
  "$comment": "BACK-COMPAT ALIAS of data/rulesets/skdd.json — retained for the stable external fetch path (older tooling + docs link to `data/canonical-v1.json`). The runtime loader no longer reads this file: `loadCanonicalV1()` now resolves the `skdd` preset from data/rulesets/skdd.json. Keep this in sync with rulesets/skdd.json (a CI drift-check is a follow-up). Vendored from reporulez (canonical source).",
  "name": "reporulez-default",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "dismiss_stale_reviews_on_push": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "clud-bug-review", "integration_id": 3944857 },
          { "context": "check-derived-docs" },
          { "context": "check-decisions" },
          { "context": "check-links" }
        ]
      }
    }
  ]
}
