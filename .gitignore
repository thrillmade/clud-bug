# Node
node_modules/
*.log
.DS_Store

# TypeScript build output (v0.7.0+ — emitted by `npm run build` from src/).
# Not checked in; recreated on every install via prepublishOnly.
dist/
*.tsbuildinfo

# Codegen — version.ts is baked from package.json by scripts/gen-version.mjs
# at every `npm run build` (prebuild) and `npm test` (pretest). Not checked
# in to avoid main/branch drift; consumers always see the version that
# matches the installed package.json.
src/core/version.ts

# Site (Next.js)
site/.next/
site/out/
site/next-env.d.ts

# npm publish dry-runs
*.tgz

# Templates rendered for local/CI shellcheck+actionlint linting (#318).
# scripts/render-ci.mjs writes here; the actionlint job in
# .github/workflows/ci.yml renders its own throwaway copy in the runner
# workspace instead of reading this directory, so nothing needs it tracked
# — and a tracked copy only goes stale against templates/*.yml.tmpl.
.ci-rendered/

# Editor
.vscode/
.idea/

# Local Claude Code session state
.claude/scheduled_tasks.lock
.claude/settings.local.json
.playwright-mcp/

# >>> logmind >>>
.logmind/cache/
.logmind/.lock
# <<< logmind <<<
